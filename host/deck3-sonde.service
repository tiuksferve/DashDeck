[Unit]
Description=Deck³ — receptor de radiossondas RS41 (box Sondas)
# Ligado e desligado pelo deckd (não arranca no boot): usa o RTL-SDR, partilhado com o ADS-B e o AIS.

[Service]
EnvironmentFile=-%h/.config/deck3/sonde.env
ExecStart=/usr/bin/python3 -u %h/PycharmProjects/Deck3/host/sonderx.py
Restart=no
