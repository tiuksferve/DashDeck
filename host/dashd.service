[Unit]
Description=DashDeck — ecrãs do uConsole: DashDeck (ESP32-C6, USB) e Deck³ (ESP32-S3, Wi-Fi)
After=default.target network-online.target

[Service]
# DASHD_ARGS: os aparelhos que este uConsole tem (--no-serial, --no-deck), escritos pelo setup/install.sh
# em ~/.config/systemd/user/dashd.service.d/aparelhos.conf
Environment=DASHD_ARGS=
ExecStart=/usr/bin/python3 -u %h/PycharmProjects/DashDeck/host/dashd.py $DASHD_ARGS
Restart=always
RestartSec=3
Environment=WAYLAND_DISPLAY=wayland-0

[Install]
WantedBy=default.target
