CONFIG_IDF_TARGET="esp32c6"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Console principal na UART0 (GPIO16/17) e secundário na USB-Serial-JTAG, para ver boot e panics.
# Depois do arranque, os logs da aplicação vão pela USB como linhas "# ..."; o host ignora o que não for JSON.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# LVGL 9
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=20
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_14=y
CONFIG_LV_USE_SPINNER=y
CONFIG_LV_USE_MSGBOX=y
CONFIG_LV_USE_IMGFONT=y
# Cartão SD: o LVGL lê imagens de "S:..." = /sd/...
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/sd/"
# O LVGL usa o heap do sistema (sem a reserva fixa de 64 KB) e guarda até 48 KB de imagens decodificadas
# (os ícones lidos do cartão SD não voltam a ser lidos a cada redesenho)
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_CACHE_DEF_SIZE=49152
CONFIG_LV_IMAGE_HEADER_CACHE_DEF_CNT=48
