CONFIG_IDF_TARGET="esp32s3"
# ESP32-S3R8: 16 MB de flash QIO e 8 MB de PSRAM octal
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Console: UART0 (GPIO43/44) + USB-Serial-JTAG secundária para ver boot e panics. Depois do arranque
# a USB passa a ser o transporte de reserva (linhas JSON, logs como "# ...").
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Wi-Fi + OTA por HTTP (o deckd serve o .bin na rede local)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_LWIP_LOCAL_HOSTNAME="deck3"

# LVGL 9 (via esp_lvgl_adapter do BSP)
CONFIG_LV_COLOR_DEPTH_16=y
# alocador do LVGL na PSRAM: main/lv_mem_psram.c
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
# CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM is not set   # 112 KB de IRAM: faz falta ao DMA e ao Wi-Fi
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_20=y
CONFIG_LV_USE_IMGFONT=y
CONFIG_LV_USE_CANVAS=y
CONFIG_LV_USE_SPINNER=y
# cache de imagens de 3 MB (PSRAM): fundos de 480x424 descodificados ficam em cache
CONFIG_LV_CACHE_DEF_SIZE=3145728

# RAM interna: o SPI do ecrã copia cada faixa (480x50x2 = 48 KB) para um buffer DMA interno.
# Mandar quase tudo o resto para a PSRAM e reservar RAM interna para o DMA e o Wi-Fi.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=512
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Bluetooth: desligado no firmware por agora (o controlador BLE come a RAM interna). Código em main/ble.c.

# Mais RAM interna livre: buffers de TX do Wi-Fi dinâmicos (podem ir para a PSRAM) e menos RX estáticos
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=y

# OTA segura: firmware novo que não chegue ao deckd volta à versão anterior (exige gravar o bootloader por USB)
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LV_THEME_DEFAULT_DARK=y

# Cartão SD (FAT): nomes longos
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255

# Imagens do cartão no LVGL: "S:icons/x.png" = /sdcard/deck3/icons/x.png; PNG (lodepng) e JPG (tjpgd)
CONFIG_LV_USE_FS_STDIO=y
CONFIG_LV_FS_STDIO_LETTER=83
CONFIG_LV_FS_STDIO_PATH="/sdcard/deck3/"
CONFIG_LV_FS_STDIO_CACHE_SIZE=4096
CONFIG_LV_USE_LODEPNG=y
CONFIG_LV_USE_TJPGD=y
